# ==============================================================================
# Climate-Resilient Workforce Agent - Docker Compose Environment Configuration
# ==============================================================================

# Backend Configuration
BACKEND_PORT=8000
WORKFORCE_WEATHER_SOURCE=open-meteo
WORKFORCE_DEFAULT_LOCATION_ID=vadodara-gujarat
WORKFORCE_WEATHER_STALE_AFTER_MINUTES=180
WORKFORCE_WEATHER_TIMEOUT_SECONDS=20

# Frontend Configuration
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000

# Optional PostgreSQL Configuration (used when --profile db is passed)
DB_PORT=5432
POSTGRES_DB=workforce_db
POSTGRES_USER=workforce
POSTGRES_PASSWORD=workforce_secret
